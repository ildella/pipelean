{
  "name": "pipelean",
  "version": "0.12.0",
  "description": "A pragmatic library for sequential async operations with first-class error handling.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ildella/pipelean",
  "repository": {
    "type": "git",
    "url": "git://github.com/ildella/pipelean.git"
  },
  "author": {
    "name": "Daniele Dellafiore",
    "url": "https://linktr.ee/ildella/"
  },
  "keywords": [
    "async",
    "promise",
    "pipeline",
    "sequential",
    "iterables",
    "error-handling",
    "functional"
  ],
  "engines": {
    "node": ">22.7"
  },
  "exports": {
    ".": "./src/index.js",
    "./eslint": "./src/eslint/plugin.js",
    "./eslint/config": "./src/eslint/config.js"
  },
  "files": [
    "src",
    "skills",
    "docs"
  ],
  "scripts": {
    "audit": "yarn npm audit",
    "audit.prod": "yarn npm audit --recursive --environment production --severity moderate",
    "check": "yarn lint && yarn dup && yarn knip",
    "check:lint": "eslint --report-unused-disable-directives .",
    "dup.inspect": "jsinspect ./src --threshold 60",
    "dup.cpd": "jscpd src --min-tokens 50 --threshold 1 --reporters console,html,json",
    "dup": "yarn dup.inspect && yarn dup.cpd",
    "knip": "knip",
    "knip.quick": "yarn knip --max-show-issues 5",
    "knip.strict": "yarn knip --include exports --include-entry-exports",
    "lint": "eslint . --cache --max-warnings 0",
    "lint.nocache": "eslint . --max-warnings 0",
    "lint.inspect": "npx @eslint/config-inspector",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "up.ui": "npx -y npm-check-updates --interactive"
  },
  "packageManager": "yarn@6.0.0-rc.23",
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.13.0",
    "eslint-nostandard": "1.4.1",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "jsinspect-plus": "3.1.3",
    "knip": "6.44.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
